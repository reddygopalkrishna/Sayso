{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sayso helper protocol v1",
  "$defs": {
    "AppMessage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "ping"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "v",
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "shutdown"
            }
          },
          "required": [
            "v",
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "HelperMessage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "ready"
            },
            "helperVersion": {
              "type": "string",
              "minLength": 1
            },
            "protocol": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "os": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "v",
            "type",
            "helperVersion",
            "protocol",
            "os"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "pong"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "v",
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "log"
            },
            "level": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ]
            },
            "msg": {
              "type": "string"
            }
          },
          "required": [
            "v",
            "type",
            "level",
            "msg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "error"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "msg": {
              "type": "string"
            }
          },
          "required": [
            "v",
            "type",
            "code",
            "msg"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
