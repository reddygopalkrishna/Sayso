{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sayso helper protocol v1",
  "$defs": {
    "AppMessage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "ping"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "v",
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "shutdown"
            }
          },
          "required": [
            "v",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "recordStart"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "v",
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "recordStop"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "v",
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "recordCancel"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "v",
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "insertText"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            }
          },
          "required": [
            "v",
            "type",
            "id",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "getContext"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "v",
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "keyPress"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "key": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "enter",
                    "tab",
                    "escape",
                    "space",
                    "delete",
                    "forwardDelete",
                    "up",
                    "down",
                    "left",
                    "right",
                    "home",
                    "end",
                    "pageUp",
                    "pageDown"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]$"
                }
              ]
            },
            "modifiers": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "cmd",
                  "shift",
                  "option",
                  "ctrl"
                ]
              }
            }
          },
          "required": [
            "v",
            "type",
            "id",
            "key",
            "modifiers"
          ],
          "additionalProperties": false
        }
      ]
    },
    "HelperMessage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "ready"
            },
            "helperVersion": {
              "type": "string",
              "minLength": 1
            },
            "protocol": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "os": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "v",
            "type",
            "helperVersion",
            "protocol",
            "os"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "pong"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "v",
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "done"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "v",
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "transcript"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "text": {
              "type": "string"
            },
            "words": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "startMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "endMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "text",
                  "startMs",
                  "endMs",
                  "p"
                ],
                "additionalProperties": false
              }
            },
            "audioMs": {
              "type": "number",
              "minimum": 0
            },
            "sttMs": {
              "type": "number",
              "minimum": 0
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "v",
            "type",
            "id",
            "text",
            "words",
            "audioMs",
            "sttMs",
            "model"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "context"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "bundleId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "appName": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "v",
            "type",
            "id",
            "bundleId",
            "appName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "hotkey"
            },
            "key": {
              "type": "string",
              "const": "fn"
            },
            "phase": {
              "type": "string",
              "enum": [
                "down",
                "up",
                "chord"
              ]
            }
          },
          "required": [
            "v",
            "type",
            "key",
            "phase"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "fnListener"
            },
            "state": {
              "type": "string",
              "enum": [
                "active",
                "unavailable"
              ]
            }
          },
          "required": [
            "v",
            "type",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "sttStatus"
            },
            "state": {
              "type": "string",
              "enum": [
                "loading",
                "ready",
                "error"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "msg": {
              "type": "string"
            }
          },
          "required": [
            "v",
            "type",
            "state",
            "model"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "log"
            },
            "level": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ]
            },
            "msg": {
              "type": "string"
            }
          },
          "required": [
            "v",
            "type",
            "level",
            "msg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "error"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "msg": {
              "type": "string"
            }
          },
          "required": [
            "v",
            "type",
            "code",
            "msg"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
