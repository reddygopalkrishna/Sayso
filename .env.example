# Copy to .env (git-ignored). Read only by the Electron main process, never the renderer.
# No quotes, no spaces around "=". Never commit real keys.

# AI cleanup. Groq (about 0.2 s) is tried first when it has a key; Gemini is the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional settings (the defaults are fine):
# SAYSO_AI_PROVIDER=auto        # auto | gemini | groq  (gemini = never send text to Groq)
# SAYSO_FAST_MODEL=qwen/qwen3.8-27b
# SAYSO_CLEANUP_LEVEL=full      # off | light | full
# SAYSO_SKIP_AI=on              # off = always use the AI, even for short clean text
# SAYSO_PAUSE_MS=600            # silence before a trailing "send" counts as a command
# SAYSO_PREVIEW_MS=1000         # how long the preview chip shows
# SAYSO_HISTORY_KEEP=50         # 0 = keep no history
