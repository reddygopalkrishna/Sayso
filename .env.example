# Copy to .env (git-ignored). Read only by the Electron main process, never the renderer.
# No quotes, no spaces around "=". Never commit real keys.

# AI cleanup. Groq (about 0.2 s) is tried first when it has a key; Gemini is the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional settings (the defaults are fine):
# SAYSO_AI_PROVIDER=auto        # auto | gemini | groq | openai  (a name = only that one, e.g. gemini = never send text to Groq or OpenAI)
# SAYSO_FAST_MODEL=qwen/qwen3.8-27b
# SAYSO_CLEANUP_LEVEL=full      # off | light | full
# SAYSO_SKIP_AI=on              # off = always use the AI, even for short clean text
# SAYSO_PAUSE_MS=600            # silence before a trailing "send" counts as a command
# SAYSO_PREVIEW_MS=1000         # how long the preview chip shows
# SAYSO_HISTORY_KEEP=50         # 0 = keep no history

# Understanding your own words ("log me in", "open a fresh tab and search for AWS"):
# when no exact command matches, an AI works out the steps from what you said and the names of the
# buttons on screen. It uses the Groq key above first. Add an OpenAI key AND a model to use OpenAI
# next (or alone). SAYSO_INTERPRET=off turns it off (also in the Settings tab).
# OPENAI_API_KEY=
# OPENAI_MODEL=
#
# OpenAI is also the second AI for text cleanup: Groq first, then OpenAI, then Gemini (each only
# when it has its key; OpenAI needs the key AND OPENAI_MODEL, and no model name is ever guessed).
# Use a fast chat model from your own OpenAI account's model list, not a slow reasoning one: a
# cleanup that takes more than a couple of seconds is dropped for the next provider. The key is
# only sent in a request header and is never logged.
# SAYSO_INTERPRET=off
#
# Optional cloud speech (OFF by default): send each held-key recording to OpenAI instead of
# transcribing on this Mac. Faster and more accurate on short phrases and names, but the audio
# leaves your Mac. Needs OPENAI_API_KEY. Also a checkbox in the Settings tab.
# SAYSO_CLOUD_SPEECH=on
# OPENAI_STT_MODEL=whisper-1    # default; it returns word times, which the pause rule needs

